# GEMINI_API_KEY: Optional free-tier Gemini API key for instant in-app AI generation.
# When running inside Antigravity IDE at $0 cost, you can leave this blank and use the Antigravity Bridge!
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted (automatically injected in AI Studio, or http://localhost:3000 locally).
APP_URL="http://localhost:3000"

# X (Twitter) Official API v2 OAuth 2.0 PKCE credentials (Free Developer Tier at https://developer.x.com)
# Leave blank to run safely in Sandbox Mode!
X_CLIENT_ID=""
X_CLIENT_SECRET=""
